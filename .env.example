# ========================================================
# 虚拟驾驶系统环境配置模板 (Virtual Driving Simulator Config)
# ========================================================

# Web 服务监听地址与端口
HOST=0.0.0.0
PORT=3000

# 网络代理设置 (用于 Google 街景瓦片、全景图下载与 OpenStreetMap 逆地理编码)
# 若支持直连或系统全局 TUN 代理，可置空 (PROXY_URL=)
PROXY_URL=http://127.0.0.1:7890

# 街景全景图片与瓦片缓存存储目录 (相对路径或绝对路径)
DATA_DIR=streetview_route

# SQLite 数据库文件路径 (持久化保存路线地址簿)
DB_PATH=routes.db
